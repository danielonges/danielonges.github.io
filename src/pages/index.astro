---
// Placeholder home — establishes the brand foundation for pages to come.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <img
        src="/logos/lockup/shaeonspace-logo.svg"
        alt="SHAEONSPACE — brackets, camera and waveform mark"
        class="hero-mark"
        width="220"
        height="180"
      />
      <p class="eyebrow">Engineer &amp; creator</p>
      <h1>Building in code, light &amp; sound</h1>
      <p class="lede">
        The personal site of Daniel Ong — a software engineer who builds across three mediums: code,
        light, and sound. Work in progress; the foundation is set.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--ss-navy);
    border-bottom: 1px solid var(--ss-navy-line);
    text-align: center;
    padding-block: 96px;
  }

  .hero-mark {
    /* stacked lockup at 220px — comfortably above the 120px minimum,
		   with the section padding providing clear space */
    width: 220px;
    height: auto;
    margin-bottom: 40px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: var(--ss-track-eyebrow);
    color: var(--ss-gold);
  }

  h1 {
    margin: 0 0 20px;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  .lede {
    max-width: 560px;
    margin-inline: auto;
    color: var(--ss-text);
  }
</style>
