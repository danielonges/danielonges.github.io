---
// Home — one page, three crafts. Section order and area express rank:
// code leads, photography (light) second, music (sound) third.
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroLogo from "../components/HeroLogo.astro";

const featured = {
  name: "Countbeans",
  description:
    "A Telegram bot that tracks and splits group expenses inside the chat where they happen — no separate app, no spreadsheet maths.",
  stack: "Python · Telegram Bot API",
  status: "Active · 2026",
  href: "https://github.com/danielonges/countbeans",
};

const projects = [
  {
    name: "The Kettle Gourmet ERP",
    description:
      "Order, inventory and B2B storefront tooling for a snack brand — the quiet systems that keep a business moving.",
    stack: "React · JavaScript",
    href: "https://github.com/danielonges/tkg-fe",
  },
  {
    name: "Visa × NUS Hackers workshop",
    description:
      "Materials for a hands-on developer workshop, run in collaboration with Visa and NUS Hackers.",
    stack: "Workshop · Teaching",
    href: "https://github.com/danielonges/hackers-dwotcl",
  },
  {
    name: "SHAEONSPACE",
    description:
      "This site — a brand system carried into code: design tokens, an animated mark and static Astro output.",
    stack: "Astro · Design tokens",
  },
];
---

<BaseLayout>
  <Fragment slot="nav">
    <a class="nav-link" href="#code">Code</a>
    <a class="nav-link" href="#photography">Photography</a>
    <a class="nav-link" href="#music">Music</a>
    <a class="nav-link" href="#contact">Contact</a>
  </Fragment>

  <section class="hero">
    <div class="wrap">
      <div class="hero-mark">
        <HeroLogo />
      </div>
      <p class="ss-eyebrow">Engineer &amp; creator</p>
      <h1>Building in code, light &amp; sound</h1>
      <p class="lede">
        The personal site of Daniel Ong — a software engineer with a photographer's eye and a
        producer's timing. Code leads; light and sound follow.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#code">View the work</a>
        <a class="btn btn-secondary" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section id="code" class="section">
    <div class="wrap">
      <header class="section-head">
        <p class="ss-eyebrow">01 · Code</p>
        <h2>Software engineering</h2>
        <p class="section-intro">
          The lead discipline — tools and products built to remove friction, with nothing arbitrary
          left in.
        </p>
      </header>

      <article class="card card-featured">
        <div class="featured-body">
          <p class="ss-eyebrow featured-label">Featured</p>
          <h3>{featured.name}</h3>
          <p>{featured.description}</p>
          <a class="card-link" href={featured.href}>
            View on GitHub<span class="arrow" aria-hidden="true">&nbsp;→</span>
          </a>
        </div>
        <dl class="featured-meta">
          <div>
            <dt>Stack</dt>
            <dd>{featured.stack}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{featured.status}</dd>
          </div>
        </dl>
      </article>

      <div class="project-grid">
        {
          projects.map((p) => (
            <article class="card">
              <h3>{p.name}</h3>
              <p>{p.description}</p>
              <p class="card-meta">{p.stack}</p>
              {p.href ? (
                <a class="card-link" href={p.href}>
                  View on GitHub<span class="arrow" aria-hidden="true">&nbsp;→</span>
                </a>
              ) : (
                <p class="card-note">You're looking at it.</p>
              )}
            </article>
          ))
        }
      </div>

      <p class="section-foot">
        <a class="card-link" href="https://github.com/danielonges">
          More on GitHub<span class="arrow" aria-hidden="true">&nbsp;→</span>
        </a>
      </p>
    </div>
  </section>

  <section id="photography" class="section band">
    <div class="wrap">
      <header class="section-head">
        <p class="ss-eyebrow">02 · Light</p>
        <h2>Photography</h2>
        <p class="section-intro">
          The second craft — frames made with the same patience as the code.
        </p>
      </header>

      <div class="frames" aria-hidden="true">
        <figure class="frame"></figure>
        <figure class="frame"></figure>
        <figure class="frame"></figure>
      </div>
      <p class="frames-note">Selects in curation; the first set lands here soon.</p>
    </div>
  </section>

  <section id="music" class="section">
    <div class="wrap music-inner">
      <header class="section-head music-head">
        <p class="ss-eyebrow">03 · Sound</p>
        <h2>Music</h2>
        <p class="section-intro">
          The third craft — productions and mixes, straight from the desk.
        </p>
        <p class="frames-note">
          <a href="https://soundcloud.com/user-738379571">Listen on SoundCloud ↗</a>
        </p>
      </header>

      <div class="music-stack" data-sc-user="https://api.soundcloud.com/users/195955610">
      <div class="player">
        <button class="play-btn" type="button" aria-label="Play">
          <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4.5 2.5v11l9-5.5z"></path>
          </svg>
          <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4 2h3v12H4zM9 2h3v12H9z"></path>
          </svg>
        </button>
        <div class="player-body">
          <svg
            class="waveform"
            viewBox="0 0 240 80"
            role="slider"
            tabindex="0"
            aria-label="Seek position"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <rect x="8" y="31" width="6" height="18" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="26" y="25" width="6" height="30" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="44" y="18" width="6" height="44" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="62" y="12" width="6" height="56" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="80" y="20" width="6" height="40" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="98" y="8" width="6" height="64" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="116" y="16" width="6" height="48" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="134" y="25" width="6" height="30" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="152" y="14" width="6" height="52" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="170" y="14" width="6" height="52" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="188" y="22" width="6" height="36" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="206" y="28" width="6" height="24" rx="3" fill="var(--ss-gold)"></rect>
            <rect x="224" y="32" width="6" height="16" rx="3" fill="var(--ss-gold)"></rect>
            <rect
              class="playhead"
              x="2"
              y="4"
              width="4"
              height="72"
              rx="2"
              fill="var(--ss-red)"></rect>
          </svg>
          <p class="player-meta">
            <span class="player-track" aria-live="polite">Press play</span>
            <span class="player-time">0:00 / 0:00</span>
          </p>
        </div>
      </div>

      <ol class="tracklist" aria-label="Latest tracks">
        <li class="track-empty">Loading latest tracks…</li>
      </ol>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="wrap">
      <p class="ss-eyebrow">Contact</p>
      <h2>Get in touch</h2>
      <p class="section-intro contact-intro">
        For work, collaborations, or a good conversation about any of the three crafts.
      </p>
      <a class="contact-mail" href="mailto:danielonges@gmail.com">danielonges@gmail.com</a>
      <p class="contact-alt">
        <a href="https://github.com/danielonges">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/daniel-ong-9b5111206">LinkedIn ↗</a>
        <a href="https://soundcloud.com/user-738379571">SoundCloud ↗</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    background: var(--ss-navy);
    border-bottom: 1px solid var(--ss-navy-line);
    text-align: center;
    padding-block: 96px;
  }

  .hero-mark {
    display: inline-block;
    margin-bottom: 40px;
  }

  .hero .ss-eyebrow {
    margin: 0 0 12px;
  }

  h1 {
    margin: 0 0 20px;
    font-family: var(--ss-display-hero);
    font-weight: 500; /* Acre Medium's native weight — avoids synthetic bolding */
    font-size: clamp(2rem, 4.5vw, 3.2rem);
  }

  .lede {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1.0625rem;
    color: var(--ss-text);
  }

  .cta-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 36px;
  }

  /* --- Section scaffolding --- */
  .section {
    padding-block: 96px;
  }

  .band {
    background: var(--ss-navy);
    border-block: 1px solid var(--ss-navy-line);
  }

  .section-head {
    margin-bottom: 48px;
  }

  .section-head .ss-eyebrow {
    margin: 0 0 12px;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .section-intro {
    max-width: 620px;
    margin: 16px 0 0;
  }

  /* --- Cards (outlined on dark; raised surface) --- */
  .card {
    background: var(--ss-navy-raised);
    border: 1px solid var(--ss-navy-line);
    border-radius: 8px;
    padding: 32px;
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--ss-gold);
  }

  .card h3 {
    margin: 0 0 10px;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0 0 14px;
  }

  .card-meta {
    font-size: 0.85rem;
    color: var(--ss-text-dim);
  }

  .card-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ss-text-dim);
  }

  .card-link {
    display: inline-block;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ss-silver);
  }

  .card-link:hover {
    color: var(--ss-white);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .card-link:hover .arrow {
    transform: translateX(3px);
  }

  /* --- Featured project --- */
  .card-featured {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    margin-bottom: 24px;
  }

  .featured-label {
    margin: 0 0 14px;
  }

  .card-featured h3 {
    font-size: 1.35rem;
    color: var(--ss-white);
  }

  .card-featured .featured-body p {
    max-width: 480px;
  }

  .featured-meta {
    margin: 0;
    align-self: center;
    display: grid;
    gap: 20px;
  }

  .featured-meta dt {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ss-text-dim);
    margin-bottom: 4px;
  }

  .featured-meta dd {
    margin: 0;
    color: var(--ss-text);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .section-foot {
    margin: 32px 0 0;
    text-align: right;
  }

  /* --- Photography (designed curation state — swap in <img> as selects land) --- */
  .frames {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .frame {
    margin: 0;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--ss-navy-line);
    border-radius: 8px;
    background: linear-gradient(165deg, var(--ss-navy-raised), var(--ss-navy) 55%, var(--ss-navy-deep));
  }

  .frame:nth-child(2) {
    background: linear-gradient(200deg, var(--ss-navy-raised), var(--ss-navy) 50%, var(--ss-navy-deep));
  }

  .frame:nth-child(3) {
    background: linear-gradient(135deg, var(--ss-navy-raised), var(--ss-navy) 60%, var(--ss-navy-deep));
  }

  .frames-note {
    margin: 20px 0 0;
    font-size: 0.85rem;
    color: var(--ss-text-dim);
  }

  /* --- Music (compact: lowest rank) --- */
  .music-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .music-head {
    margin-bottom: 0;
  }

  .music-head .frames-note {
    margin-top: 12px;
  }

  .music-stack {
    width: 100%;
    max-width: 420px;
    justify-self: end;
  }

  .player {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .play-btn {
    flex: none;
    width: 48px;
    height: 48px;
    margin-top: 8px;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    background: var(--ss-gold);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .play-btn:hover {
    background: var(--ss-gold-bright);
  }

  .play-btn svg {
    width: 16px;
    height: 16px;
    fill: var(--ss-navy-deep);
  }

  .player .icon-pause {
    display: none;
  }

  .music-stack.playing .icon-pause {
    display: block;
  }

  .music-stack.playing .icon-play {
    display: none;
  }

  .player-body {
    flex: 1;
    min-width: 0;
  }

  .waveform {
    width: 100%;
    display: block;
    cursor: pointer;
  }

  .player-meta {
    margin: 6px 0 0;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--ss-text-dim);
  }

  .player-track {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player-time {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .tracklist {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px; /* between-row breathing room — proximity grouping */
  }

  .track {
    /* reset iOS/Safari default button chrome that collapsed these to pills */
    appearance: none;
    -webkit-appearance: none;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 13px 16px;
    border: 1px solid var(--ss-navy-line);
    border-radius: 8px;
    background: var(--ss-navy-raised);
    text-align: left;
    font-family: var(--ss-body);
    color: var(--ss-text);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .track:hover {
    border-color: var(--ss-gold);
  }

  .track[aria-current="true"] {
    border-color: var(--ss-red);
  }

  /* Left marker: track number, swapping to a live equaliser when playing */
  .track-marker {
    flex: none;
    width: 18px;
    display: grid;
    place-items: center;
  }

  .track-num {
    font-size: 0.82rem;
    color: var(--ss-text-dim);
    font-variant-numeric: tabular-nums;
  }

  .track-bars {
    display: none;
    align-items: flex-end;
    gap: 2px;
    width: 16px;
    height: 14px;
  }

  .track-bars span {
    flex: 1;
    height: 40%;
    background: var(--ss-red);
    border-radius: 1px;
  }

  .track[aria-current="true"] .track-num {
    display: none;
  }

  .track[aria-current="true"] .track-bars {
    display: flex;
  }

  /* Equaliser animates only while the current track is actually playing */
  .music-stack.playing .track[aria-current="true"] .track-bars span {
    animation: ss-eq 0.9s ease-in-out infinite alternate;
  }

  .track-bars span:nth-child(1) {
    animation-delay: -0.6s;
  }
  .track-bars span:nth-child(2) {
    animation-delay: -0.2s;
  }
  .track-bars span:nth-child(3) {
    animation-delay: -0.4s;
  }

  @keyframes ss-eq {
    from {
      height: 25%;
    }
    to {
      height: 100%;
    }
  }

  .track-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    color: var(--ss-silver);
  }

  .track[aria-current="true"] .track-title {
    color: var(--ss-white);
  }

  .track-plays {
    flex: none;
    font-size: 0.8rem;
    color: var(--ss-text-dim);
    font-variant-numeric: tabular-nums;
  }

  .track-empty {
    padding: 14px 16px;
    border: 1px solid var(--ss-navy-line);
    border-radius: 8px;
    background: var(--ss-navy-raised);
    font-size: 0.9rem;
    color: var(--ss-text-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .music-stack.playing .track[aria-current="true"] .track-bars span {
      animation: none;
      height: 70%;
    }
  }

  /* --- Contact --- */
  .contact {
    padding-block: 96px;
    border-top: 1px solid var(--ss-navy-line);
    text-align: center;
  }

  .contact .ss-eyebrow {
    margin: 0 0 12px;
  }

  .contact-intro {
    margin-inline: auto;
  }

  .contact-mail {
    /* gold display type ≥24px — the approved large-text accent use */
    display: inline-block;
    margin-top: 28px;
    font-family: var(--ss-display);
    font-weight: 600;
    font-size: 1.6rem;
    color: var(--ss-gold);
  }

  .contact-mail:hover {
    color: var(--ss-gold-bright);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .contact-alt {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin: 20px 0 0;
    font-size: 0.95rem;
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .hero,
    .section,
    .contact {
      padding-block: 64px;
    }

    .card-featured {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .featured-meta {
      align-self: start;
      grid-template-columns: 1fr 1fr;
    }

    .project-grid,
    .frames {
      grid-template-columns: 1fr;
    }

    .frame {
      aspect-ratio: 3 / 2;
    }

    .music-inner {
      grid-template-columns: 1fr;
    }

    .music-stack {
      justify-self: start;
    }
  }

  @media (max-width: 480px) {
    .cta-row {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }
</style>

<script>
  // SoundCloud player via the official Widget API. Nothing third-party loads
  // on initial paint; the widget is created when the music section scrolls
  // into view, which populates the track list (titles + play counts) and lets
  // the red playhead track real playback. Play counts come from the widget's
  // own getSounds() — no scraping, no credentials.
  const stack = document.querySelector<HTMLElement>(".music-stack");
  const btn = stack?.querySelector<HTMLButtonElement>(".play-btn");
  const wave = stack?.querySelector<SVGSVGElement>(".waveform");
  const playhead = stack?.querySelector<SVGRectElement>(".playhead");
  const trackEl = stack?.querySelector<HTMLElement>(".player-track");
  const timeEl = stack?.querySelector<HTMLElement>(".player-time");
  const list = stack?.querySelector<HTMLOListElement>(".tracklist");
  const section = document.querySelector<HTMLElement>("#music");

  if (stack && btn && wave && playhead && trackEl && timeEl && list && section) {
    const TRAVEL = 232; // playhead travel in viewBox units (x 2 → 234)
    let widget: any = null;
    let ready: Promise<any> | null = null;
    let playing = false;
    let duration = 0;
    let rows: HTMLButtonElement[] = [];

    const fmt = (ms: number) => {
      const s = Math.max(0, Math.round(ms / 1000));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    };

    const fmtPlays = (n: number) => {
      try {
        return new Intl.NumberFormat("en-GB", {
          notation: "compact",
          maximumFractionDigits: 1,
        }).format(n);
      } catch {
        return String(n);
      }
    };

    // PLAY_PROGRESS fires only every few hundred ms — dead-reckon between
    // events so the playhead moves at frame rate, re-syncing on each event.
    // Reduced motion steps on events instead.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let basePos = 0;
    let baseTime = 0;
    let rafId = 0;

    const paint = (ms: number) => {
      const p = duration ? Math.min(ms / duration, 1) : 0;
      playhead.setAttribute("transform", `translate(${(p * TRAVEL).toFixed(2)} 0)`);
      const pct = String(Math.round(p * 100));
      if (wave.getAttribute("aria-valuenow") !== pct) wave.setAttribute("aria-valuenow", pct);
      timeEl.textContent = `${fmt(ms)} / ${fmt(duration)}`;
    };

    const tick = () => {
      if (!playing) return;
      paint(basePos + (performance.now() - baseTime));
      rafId = requestAnimationFrame(tick);
    };

    const startTicking = () => {
      if (reduceMotion) return;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(tick);
    };

    const setCurrent = (idx: number) => {
      rows.forEach((r, i) => r.setAttribute("aria-current", i === idx ? "true" : "false"));
    };

    const renderTracks = (sounds: any[]) => {
      const top = sounds.filter((s) => s && s.title).slice(0, 3);
      if (!top.length) {
        list.innerHTML = '<li class="track-empty">Open SoundCloud for the latest tracks ↗</li>';
        return;
      }
      list.innerHTML = "";
      rows = top.map((s, i) => {
        const li = document.createElement("li");
        const b = document.createElement("button");
        b.type = "button";
        b.className = "track";
        b.setAttribute("aria-current", "false");
        b.innerHTML =
          '<span class="track-marker" aria-hidden="true">' +
          `<span class="track-num">${i + 1}</span>` +
          '<span class="track-bars"><span></span><span></span><span></span></span>' +
          "</span>" +
          '<span class="track-title"></span><span class="track-plays"></span>';
        b.querySelector(".track-title")!.textContent = s.title;
        if (typeof s.playback_count === "number") {
          b.querySelector(".track-plays")!.textContent = `${fmtPlays(s.playback_count)} plays`;
        }
        b.addEventListener("click", () => widget?.skip(i));
        li.appendChild(b);
        list.appendChild(li);
        return b;
      });
    };

    const loadApi = () =>
      new Promise<void>((resolve, reject) => {
        if ((window as any).SC) return resolve();
        const el = document.createElement("script");
        el.src = "https://w.soundcloud.com/player/api.js";
        el.onload = () => resolve();
        el.onerror = () => reject(new Error("widget script failed"));
        document.head.appendChild(el);
      });

    // Create the (silent) widget and resolve once it's READY, so the track
    // list and metadata are queryable. Shared promise — callers await the same.
    const ensureWidget = () => {
      if (ready) return ready;
      ready = (async () => {
        await loadApi();
        const SC = (window as any).SC;
        const frame = document.createElement("iframe");
        frame.title = "SoundCloud player";
        frame.allow = "autoplay";
        frame.setAttribute("style", "position:absolute;left:-9999px;width:2px;height:2px;border:0");
        frame.src =
          "https://w.soundcloud.com/player/?auto_play=false&show_teaser=false&url=" +
          encodeURIComponent(stack.dataset.scUser ?? "");
        stack.appendChild(frame);
        const w = SC.Widget(frame);

        w.bind(SC.Widget.Events.PLAY, () => {
          playing = true;
          stack.classList.add("playing");
          btn.setAttribute("aria-label", "Pause");
          w.getCurrentSoundIndex((idx: number) => setCurrent(idx));
          w.getCurrentSound((s: any) => {
            if (s?.title) trackEl.textContent = s.title;
          });
          w.getDuration((d: number) => {
            duration = d;
          });
          w.getPosition((pos: number) => {
            basePos = pos;
            baseTime = performance.now();
          });
          startTicking();
        });
        w.bind(SC.Widget.Events.PAUSE, () => {
          playing = false;
          cancelAnimationFrame(rafId);
          stack.classList.remove("playing");
          btn.setAttribute("aria-label", "Play");
        });
        w.bind(SC.Widget.Events.PLAY_PROGRESS, (e: any) => {
          basePos = e.currentPosition;
          baseTime = performance.now();
          if (reduceMotion || !playing) paint(e.currentPosition);
        });
        w.bind(SC.Widget.Events.FINISH, () => {
          cancelAnimationFrame(rafId);
          basePos = 0;
          playhead.setAttribute("transform", "translate(0 0)");
          timeEl.textContent = `0:00 / ${fmt(duration)}`;
        });

        await new Promise<void>((res) => {
          w.bind(SC.Widget.Events.READY, () => {
            widget = w;
            w.getSounds((sounds: any[]) => renderTracks(sounds || []));
            res();
          });
        });
        return w;
      })().catch((err) => {
        list.innerHTML = '<li class="track-empty">Open SoundCloud for the latest tracks ↗</li>';
        throw err;
      });
      return ready;
    };

    btn.addEventListener("click", async () => {
      try {
        const w = await ensureWidget();
        playing ? w.pause() : w.play();
      } catch {
        trackEl.textContent = "Player unavailable — use the SoundCloud link";
      }
    });

    const seekTo = (ratio: number) => {
      if (!widget || !duration) return;
      widget.seekTo(Math.max(0, Math.min(1, ratio)) * duration);
    };
    wave.addEventListener("click", (e) => {
      const rect = wave.getBoundingClientRect();
      seekTo((e.clientX - rect.left) / rect.width);
    });
    wave.addEventListener("keydown", (e) => {
      if (!widget || (e.key !== "ArrowRight" && e.key !== "ArrowLeft")) return;
      e.preventDefault();
      const delta = e.key === "ArrowRight" ? 5000 : -5000;
      widget.getPosition((pos: number) => widget.seekTo(Math.max(0, pos + delta)));
    });

    // Warm the widget when the section nears the viewport so the track list
    // is populated by the time it's on screen — without touching initial load.
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((en) => en.isIntersecting)) {
            io.disconnect();
            ensureWidget().catch(() => {});
          }
        },
        { rootMargin: "200px" },
      );
      io.observe(section);
    }
  }
</script>
